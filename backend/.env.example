# Local settings for the backend -- copy to backend/.env (gitignored) and fill in.
# Real environment variables override this file.

# --- AI: Ollama Cloud (app/ai/) --------------------------------------------
# API key from https://ollama.com/settings/keys -- never commit it
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com

# Default model for all projects ...
OLLAMA_MODEL=deepseek-v4.1-flash
# ... and a model per project (module id in upper case), overrides OLLAMA_MODEL.
# Cloud models: https://ollama.com/search?c=cloud -- the AI marker in the UI lists them too.
OLLAMA_MODEL_BDS=deepseek-v4.1-flash
OLLAMA_MODEL_CRA=deepseek-v4.1-flash

# OLLAMA_TIMEOUT_S=120
# OLLAMA_STATUS_TTL_S=30
