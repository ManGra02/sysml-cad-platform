name: sysml-cad-poc

services:
  postgres:
    image: postgres:16
    container_name: sysml2-postgres
    environment:
      POSTGRES_DB: sysml2
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: mysecretpassword
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d sysml2"]
      interval: 5s
      timeout: 3s
      retries: 20

  sysml-api:
    build:
      context: ../vendor/SysML-v2-API-Services
      dockerfile: Dockerfile
    container_name: sysml2-api
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "9000:9000"
    environment:
      SYSML_JDBC_URL: "jdbc:postgresql://postgres:5432/sysml2"
      SYSML_JDBC_USER: "postgres"
      SYSML_JDBC_PASSWORD: "mysecretpassword"
    # Ueberschreibt das CMD des Forks: dessen Startzeile kennt den
