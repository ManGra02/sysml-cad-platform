    command:
      - /app/start-sysml
      - -Dhttp.address=0.0.0.0
      - -Dhttp.port=9000
      - -Dplay.filters.hosts.allowed.0=.
      - -Dplay.http.secret.key=${PLAY_SECRET:?bitte in docker/.env setzen -- 'make secret'}
    volumes:
      - ivy2:/root/.ivy2
      - sbt:/root/.sbt
      - coursier:/root/.cache/coursier

  jupyter:
    build:
      context: ..
      dockerfile: docker/jupyter.Dockerfile
    container_name: sysml2-jupyter
    depends_on:
