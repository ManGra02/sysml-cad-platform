import re, zlib
data = open("Use Case Presentation CAD bidirectional sync.pdf","rb").read()
streams=[]
for m in re.finditer(rb'stream\r?\n', data):
    s=m.end(); e=data.find(b'endstream', s)
    if e==-1: continue
    try: streams.append(zlib.decompress(data[s:e]))
    except Exception: pass
content=[s for s in streams if b'TJ' in s or b'Tj' in s]

def unesc(b):
    out=bytearray(); i=0
    while i<len(b):
        c=b[i]
        if c==0x5c and i+1<len(b):
            n=b[i+1]
            mp={0x6e:10,0x72:13,0x74:9,0x28:40,0x29:41,0x5c:92}
            if n in mp: out.append(mp[n]); i+=2; continue
            if 0x30<=n<=0x37:
                j=i+1; oc=''
                while j<len(b) and 0x30<=b[j]<=0x37 and len(oc)<3: oc+=chr(b[j]); j+=1
                out.append(int(oc,8)&0xFF); i=j; continue
            out.append(n); i+=2; continue
        out.append(c); i+=1
    return bytes(out).decode('latin-1')

def parse_page(s):
    items=[]
    tm=None
    # tokenize by lines-ish
    for m in re.finditer(rb'([-\d.]+)\s+([-\d.]+)\s+([-\d.]+)\s+([-\d.]+)\s+([-\d.]+)\s+([-\d.]+)\s+Tm|\[(.*?)\]\s*TJ|\((.*?)\)\s*Tj', s, re.S):
        if m.group(1):
            tm=(float(m.group(5)), float(m.group(6)))
        elif m.group(7) is not None:
            arr=m.group(7)
            txt=''.join(unesc(x) for x in re.findall(rb'\((.*?)(?<!\\)\)', arr, re.S))
            if txt.strip() and tm: items.append((tm[1], tm[0], txt))
        elif m.group(8) is not None:
            txt=unesc(m.group(8))
            if txt.strip() and tm: items.append((tm[1], tm[0], txt))
    # group by y
    items.sort(key=lambda t:(-t[0], t[1]))
    lines=[]; cur=None; cury=None
    for y,x,t in items:
        if cury is None or abs(y-cury)>3:
            if cur is not None: lines.append(cur)
            cur=t; cury=y
        else:
            cur+=t
    if cur is not None: lines.append(cur)
    return lines

NOISE = re.compile(r'^(Position|Hilfslinie|[\d,.\s]+)$')
for i,s in enumerate(content):
    lines=[l.rstrip() for l in parse_page(s)]
    lines=[l for l in lines if l.strip() and not NOISE.match(l.strip())]
    print(f"\n{'='*70}\nSLIDE {i+1}\n{'='*70}")
    for l in lines: print(l)
