{
  // Linux only. The same container as ../devcontainer.json, but in the HOST's
  // network, so the backend reaches the FreeCAD bridge of a natively installed
  // FreeCAD (reasons per line in docker-compose.yml next to this file).
  // VS Code offers both configurations on "Reopen in Container"; both are the
  // Compose project sysml-cad-platform, so only one of them runs at a time.
  //
  // devcontainer.json has no `extends`: everything below except
  // dockerComposeFile, the ports and updateRemoteUserUID is a copy of
  // ../devcontainer.json -- change both.
  "name": "sysml-cad-platform (Linux, native FreeCAD)",

  // The default configuration's files, then the host-network overlays: the
  // platform's (this folder) and each sub-project's own.
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../../bidirectional-sync/.devcontainer/docker-compose.dev.yml",
    "docker-compose.yml",
    "../../bidirectional-sync/.devcontainer/docker-compose.host-network.yml"
  ],
  "service": "dev",
  "runServices": ["dev"],
  "workspaceFolder": "/workspaces/sysml-cad-platform",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  // vscode gets the host user's UID: bridge.json is mode 0600, owned by the
  // user that runs FreeCAD. (The default on Linux -- stated, because it is
  // load-bearing here.)
  "updateRemoteUserUID": true,

  "features": {
    // Node 22 LTS and the pnpm of frontend/package.json ("packageManager").
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "10.34.5"
    }
  },

  // No forwardPorts: in the host's network the backend and Vite already listen
  // on the host's 127.0.0.1:8000 and :5173. A forward would try to bind the
  // same ports a second time.
  "otherPortsAttributes": { "onAutoForward": "ignore" },

  // Backend + frontend dependencies, then every sub-project's own hook
  // (<sub-project>/.devcontainer/post-create.sh).
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "Anthropic.claude-code",
        // bidirectional-sync: shows build123d / STEP geometry
        "bernhard-42.ocp-cad-viewer"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python"
      }
    }
  }
}
