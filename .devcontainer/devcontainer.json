{
  "name": "sysml-cad-poc",
  "dockerComposeFile": [
    "../docker/docker-compose.yml",
    "docker-compose.dev.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspaces/sysml-cad-poc",
  "remoteUser": "vscode",

  // docker/.env is gitignored, so it is absent on a fresh clone. Compose
  // interpolates the WHOLE merged file for `config` -- sysml-api included,
  // even though runServices is only dev + postgres -- and PLAY_SECRET uses the
  // :? error operator, so the devcontainer dies before anything is built.
  // This runs on the host before Compose and creates the file if missing;
  // same value as `make secret`.
  "initializeCommand": [
    "sh", "-c",
    "test -f '${localWorkspaceFolder}/docker/.env' || printf 'PLAY_SECRET=%s\\n' \"$(head -c 48 /dev/urandom | base64 | tr -d '\\n')\" > '${localWorkspaceFolder}/docker/.env'"
  ],

  "remoteEnv": {
    "PATH": "/opt/venv/bin:${containerEnv:PATH}"
  },

  "runServices": ["dev", "postgres"],
  "shutdownAction": "stopCompose",

  "postCreateCommand": "/opt/venv/bin/python -c \"import build123d, pint; print('build123d', build123d.__version__, '| pint', pint.__version__)\"",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "bernhard-42.ocp-cad-viewer",
        "Anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
