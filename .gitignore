# Frontend build output (served by the backend)
# (Vite empties the directory on every build; without a build the backend shows a notice page)
backend/app/static/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Node
node_modules/
.vite/

# Runtime: port and token of the running bridge, never commit
bridge.json

# Local secrets (OLLAMA_API_KEY, ...), template: backend/.env.example
.env

# Tools
.ruff_cache/
.mypy_cache/
.playwright-mcp/
.DS_Store
Thumbs.db

# BDS: per-workspace write log and last verification (the mappings are design intent and belong in git)
data/bds/*/sync_log.jsonl
data/bds/*/last_run.json
