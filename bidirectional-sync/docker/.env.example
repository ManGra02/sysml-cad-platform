# Copy to docker/.env and generate a real value -- `make secret` does both.
#
# Play refuses to start in production mode without a sufficiently long secret
# key. This file lives in docker/, NOT in the project root: Compose resolves
# --env-file against the directory of the first -f file, and the Dev Containers
# extension builds its own compose command with no way to pass --env-file.
PLAY_SECRET=generate-me-see-make-secret
