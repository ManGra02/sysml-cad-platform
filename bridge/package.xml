<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>SysML-CAD Platform Bridge</name>
  <description>
    Bridge between FreeCAD and the SysML-CAD platform. Exposes the CAD model through a
    local HTTP/WebSocket service (127.0.0.1 only). Deliberately contains no domain logic.
  </description>
  <version>0.1.0</version>
  <date>2026-09-11</date>
  <maintainer email="a.alex2302@gmail.com">Project group SysML v2 to 3D</maintainer>
  <license file="LICENSE">MIT</license>
  <icon>Resources/icons/bridge.svg</icon>
  <freecadmin>1.1.0</freecadmin>
  <tag>utility</tag>
  <tag>integration</tag>

  <content>
    <workbench>
      <!-- Loader rule 1: without this <workbench> element, InitGui.py is NEVER executed.
           Loader rule 2: <subdirectory> otherwise falls back to <name>; the code lives
                          here in the addon's root directory, hence './'.
           Loader rule 3: <classname> must be exactly the Python class name. -->
      <classname>CadBridgeWorkbench</classname>
      <name>SysMLCadBridge</name>
      <subdirectory>./</subdirectory>
      <icon>Resources/icons/bridge.svg</icon>
      <description>CAD bridge for the SysML-CAD platform</description>
      <freecadmin>1.1.0</freecadmin>
    </workbench>
  </content>
</package>
